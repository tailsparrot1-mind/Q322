{
  "name": "vkus-license-store-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vkus-license-store --local",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply vkus-license-store --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261118.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
